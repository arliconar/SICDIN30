## =======================================================================
## Visual Studio & .NET / VB.NET gitignore para SICDIN30
## =======================================================================

# --- Archivos específicos de usuario y entorno ---
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.env

# --- Directorio de caché y opciones de Visual Studio (2015/2017/2019/2022/2026) ---
.vs/

# --- Resultados de compilación y binarios ---
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
Generated\ Files/

# Archivos intermedios generados por Visual Studio / MSBuild
*.obj
*.pdb
*.idb
*.iobj
*.ilk
*.pch
*.ipdb
*.pgc
*.pgd
*.rsp
!Directory.Build.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc
*.meta

# --- NuGet ---
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
!**/[Pp]ackages/repositories.config
*.nuget.props
*.nuget.targets
project.assets.json
project.lock.json
project.fragment.lock.json

# --- Bases de datos y archivos de bloqueo temporales ---
# Bloqueos de Microsoft Access (.accdb y .mdb)
*.laccdb
*.ldb
# SQL Server CE, SQLite y temporales de bases de datos
*.sdf
*.opensdf
*.opendb
*.db-wal
*.db-shm
*.db-journal
# Archivos de volcado / dumps de error
*.dmp
crash.log

# --- Archivos temporales de Office / Excel (interop) ---
~$*

# --- Publicación, Certificados y Claves de Firma ---
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
*.pfx
*.snk
*.publishsettings

# --- Pruebas y cobertura de código ---
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
TestResult.xml
*.VisualState.xml
nunit-*.xml
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
BenchmarkDotNet.Artifacts/

# --- Editores alternativos (VS Code, JetBrains Rider) ---
.vscode/
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# --- Archivos del sistema operativo (Windows / macOS) ---
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Archivos y recursos específicos que deben mantenerse ---
!syste.dat